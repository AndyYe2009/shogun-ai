# AI 后端: ollama (免费本地) 或 anthropic (付费云端) 或 rule (纯规则引擎)
AI_BACKEND=rule

# 后台模式: true = 不抢焦点不切屏 (通过 Windows API 后台发按键，不影响你做其他事)
BACKGROUND_MODE=false

# Ollama 配置
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=minicpm-v:8b
OLLAMA_DECISION_MODEL=minicpm-v:8b

# Anthropic API Key (仅 AI_BACKEND=anthropic 时需要)
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Player/Enemy max HP
PLAYER_MAX_HP=60
ENEMY_MAX_HP=20
